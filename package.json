{
  "name": "cloud-media-share",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",

    "web:build": "bun --filter web build",
    "web:start": "bun --filter web start",
    "worker:start": "bun --filter worker start",

    "db:generate": "bun --filter @repo/db generate",
    "db:migrate": "bun --filter @repo/db migrate",
    "db:studio": "bun --filter @repo/db studio",
    "db:push": "bun --filter @repo/db push"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
